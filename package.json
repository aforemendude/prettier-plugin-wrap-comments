{
  "author": "aforemendude",
  "bugs": {
    "url": "https://github.com/aforemendude/prettier-plugin-wrap-comments/issues"
  },
  "description": "A Prettier plugin that wraps non-JSDoc JavaScript and TypeScript comments as Markdown.",
  "devDependencies": {
    "@types/node": "20.19.43",
    "prettier": "3.9.6",
    "prettier-plugin-jsdoc": "1.8.1",
    "prettier-plugin-wrap-comments-stable": "npm:@aforemendude/prettier-plugin-wrap-comments@1.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/aforemendude/prettier-plugin-wrap-comments",
  "keywords": [
    "prettier",
    "prettier-plugin",
    "comments",
    "markdown",
    "typescript"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@aforemendude/prettier-plugin-wrap-comments",
  "peerDependencies": {
    "prettier": ">=3.0.0 <4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aforemendude/prettier-plugin-wrap-comments.git"
  },
  "scripts": {
    "benchmark": "vitest bench --run",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write --cache --cache-strategy metadata .",
    "format:check": "prettier --check --cache --cache-strategy metadata .",
    "format:nocache": "prettier --write .",
    "prepack": "npm install && git diff --exit-code -- package-lock.json && npm run verify",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "prettier --check . && npm run typecheck && npm run build && npm run test"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.1.1"
}