{
  "author": "aforemendude",
  "bugs": {
    "url": "https://github.com/aforemendude/prettier-plugin-wrap-comments/issues"
  },
  "description": "A Prettier plugin that wraps non-JSDoc JavaScript and TypeScript comments as Markdown.",
  "devDependencies": {
    "@types/node": "18.19.130",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/aforemendude/prettier-plugin-wrap-comments",
  "keywords": [
    "prettier",
    "prettier-plugin",
    "comments",
    "markdown",
    "typescript"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@aforemendude/prettier-plugin-wrap-comments",
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aforemendude/prettier-plugin-wrap-comments.git"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run verify",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc -p tsconfig.test.json",
    "verify": "npm run format:check && npm run typecheck && npm run build && npm run test"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.0.6"
}
